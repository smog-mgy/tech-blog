{"config":{"lang":["en"],"separator":"[\\s\\u200b\\u3000\\-\u3001\u3002\uff0c\uff0e\uff1f\uff01\uff1b]+","pipeline":["stemmer"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"\u6211\u7684\u6280\u672f\u535a\u5ba2","text":"<p>\u8bb0\u5f55\u5b66\u4e60\u3001\u9879\u76ee\u5b9e\u8df5\u4e0e\u8e29\u5751\u7ecf\u5386\u7684\u6280\u672f\u535a\u5ba2\u3002</p>"},{"location":"#_2","title":"\u6700\u65b0\u6587\u7ae0","text":"<ul> <li>\u7528 Ollama \u642d\u5efa\u672c\u5730 RAG \u95ee\u7b54\u5e94\u7528\uff08\u4ece\u8e29\u5751\u5230\u91cd\u5199\uff09 \u2014\u2014 2026-09-18</li> </ul>"},{"location":"#_3","title":"\u5173\u4e8e\u8fd9\u4e2a\u535a\u5ba2","text":"<ul> <li>\u4e3b\u8981\u5199 Python / \u5927\u6a21\u578b\u5e94\u7528 / Agent \u5f00\u53d1 \u76f8\u5173\u7684\u5185\u5bb9</li> <li>\u6bcf\u7bc7\u6587\u7ae0\u5c3d\u91cf\u505a\u5230\uff1a\u8fc7\u7a0b\u53ef\u590d\u73b0\u3001\u4ee3\u7801\u53ef\u8fd0\u884c\u3001\u5751\u70b9\u8bb2\u6e05\u695a</li> <li>\u6587\u7ae0\u4f1a\u6301\u7eed\u66f4\u65b0\uff0c\u6b22\u8fce\u4ea4\u6d41</li> </ul>"},{"location":"about/","title":"\u5173\u4e8e\u6211","text":"<p>\u4e00\u540d\u6b63\u5728\u5b66\u4e60 Python \u4e0e\u5927\u6a21\u578b\u5e94\u7528\u5f00\u53d1\u7684\u5f00\u53d1\u8005\u3002</p> <ul> <li>\u4e3b\u8981\u5174\u8da3\uff1aPython\u3001RAG\u3001Agent \u5f00\u53d1\u3001AI \u5e94\u7528\u843d\u5730</li> <li>\u5199\u4f5c\u539f\u5219\uff1a\u53ea\u5199\u81ea\u5df1\u5b9e\u9645\u8dd1\u901a\u7684\u5185\u5bb9\uff0c\u6bcf\u4e2a\u5751\u90fd\u8bb0\u5f55\u771f\u5b9e\u8fc7\u7a0b</li> </ul> <p>\u8fd9\u91cc\u53ef\u4ee5\u8865\u5145\u4f60\u7684\u81ea\u6211\u4ecb\u7ecd\u3001\u8054\u7cfb\u65b9\u5f0f\u3001GitHub \u94fe\u63a5\u7b49\uff0c\u76f4\u63a5\u5728\u672c\u6587\u6863\u4e2d\u4fee\u6539\u5373\u53ef\u3002</p>"},{"location":"posts/rag-ollama/","title":"\u7528 Ollama \u642d\u5efa\u672c\u5730 RAG \u95ee\u7b54\u5e94\u7528\uff1a\u4ece\u8e29\u5751\u5230\u91cd\u5199","text":"<p>\u65e5\u671f\uff1a2026-09-18 \u6807\u7b7e\uff1aPython \u00b7 RAG \u00b7 Ollama \u00b7 Streamlit</p>"},{"location":"posts/rag-ollama/#_1","title":"\u80cc\u666f","text":"<p>\u6211\u60f3\u505a\u4e00\u4e2a\u672c\u5730\u7684 PDF \u95ee\u7b54\u5e94\u7528\uff1a\u4e0a\u4f20 PDF\uff0c\u7136\u540e\u5411\u5b83\u63d0\u95ee\uff0c\u5168\u7a0b\u6570\u636e\u4e0d\u51fa\u672c\u673a\u3002\u6700\u521d\u57fa\u4e8e <code>embedchain</code> \u6846\u67b6\u5feb\u901f\u642d\u4e86\u4e00\u4e2a\uff0c\u4f46\u5b9e\u9645\u7528\u8d77\u6765\u53d1\u73b0\u56de\u7b54\u5f88\"\u7b28\"\u3001\u7b54\u975e\u6240\u95ee\u3001\u8fd8\u4f1a\u7f16\u9020\u5185\u5bb9\u3002\u8fd9\u7bc7\u6587\u7ae0\u8bb0\u5f55\u6211\u4ece\"\u80fd\u7528\"\u5230\"\u597d\u7528\"\u7684\u8fc7\u7a0b\uff0c\u91cd\u70b9\u662f\u8e29\u8fc7\u7684\u5751\u3002</p>"},{"location":"posts/rag-ollama/#embedchain","title":"\u7b2c\u4e00\u7248\uff1aembedchain \u5feb\u901f\u642d\u5efa","text":"<p>\u7b2c\u4e00\u7248\u4ee3\u7801\u5f88\u77ed\uff0c\u6838\u5fc3\u5c31\u4e00\u4e2a\u914d\u7f6e\uff1a</p> <pre><code>from embedchain import App\n\napp = App.from_config(config={\n    \"llm\": {\"provider\": \"ollama\", \"config\": {\"model\": \"llama3.2:latest\", ...}},\n    \"vectordb\": {\"provider\": \"chroma\", \"config\": {\"dir\": db_path}},\n    \"embedder\": {\"provider\": \"ollama\", \"config\": {\"model\": \"llama3.2:latest\", ...}},\n})\n</code></pre> <p>\u8868\u9762\u770b\u4e00\u5207\u6b63\u5e38\uff0c\u5b9e\u9645\u8dd1\u8d77\u6765\u95ee\u9898\u4e00\u5806\u3002</p>"},{"location":"posts/rag-ollama/#1ollama-python","title":"\u5751 1\uff1a<code>ollama</code> Python \u5305\u7f3a\u5931","text":"<p>\u62a5\u9519\u4fe1\u606f</p> <p><code>ImportError: Ollama requires extra dependencies. Install with pip install ollama</code></p> <p>embedchain \u7684 Ollama \u63d0\u4f9b\u65b9\u9700\u8981 <code>ollama</code> \u8fd9\u4e2a Python \u5e93\uff0c\u4f46\u5b83\u4e0d\u4f1a\u968f embedchain \u81ea\u52a8\u5b89\u88c5\u3002Ollama \u8f6f\u4ef6\u672c\u8eab\u88c5\u597d\u4e86\u4e5f\u6ca1\u7528\uff0c\u8fd9\u662f Python \u5c42\u9762\u7684\u4f9d\u8d56\u7f3a\u5931\u3002</p> <p>\u89e3\u51b3\uff1a<code>pip install ollama</code></p>"},{"location":"posts/rag-ollama/#2","title":"\u5751 2\uff1a\u7528\u5bf9\u8bdd\u6a21\u578b\u5f53\u5d4c\u5165\u6a21\u578b","text":"<p>\u7b2c\u4e00\u7248\u628a <code>llama3.2:latest</code> \u540c\u65f6\u7528\u4f5c\u5bf9\u8bdd\u6a21\u578b\u548c\u5d4c\u5165\u6a21\u578b\uff08embedder\uff09\u3002\u5b9e\u9645\u4e0a llama3.2 \u4e0d\u652f\u6301 embedding\uff08Ollama \u4e2d\u5b83\u7684\u80fd\u529b\u53ea\u6709 <code>completion</code>\uff09\uff0c\u8c03\u7528\u5d4c\u5165\u63a5\u53e3\u76f4\u63a5\u8d85\u65f6\uff0c\u6dfb\u52a0\u6587\u6863\u65f6\u5931\u8d25\u3002</p> <p>\u89e3\u51b3\uff1a\u62c9\u53d6\u4e13\u95e8\u7684\u5d4c\u5165\u6a21\u578b <code>nomic-embed-text</code>\uff0c\u5e76\u5728 embedder \u914d\u7f6e\u4e2d\u6307\u5b9a\u3002</p>"},{"location":"posts/rag-ollama/#3","title":"\u5751 3\uff08\u6700\u5173\u952e\uff09\uff1a\u5bf9\u8bdd\u5386\u53f2\u5168\u5c40\u5171\u4eab\uff0c\u5e7b\u89c9\u88ab\"\u56de\u4f20\u5f3a\u5316\"","text":"<p>\u8fd9\u662f\u6700\u96be\u53d1\u73b0\u7684\u95ee\u9898\u3002\u8868\u73b0\u4e3a\uff1a\u63d0\u95ee\u8d8a\u6765\u8d8a\"\u7b28\"\uff0c\u4e14\u9519\u8bef\u6709\u5ef6\u7eed\u6027\u3002</p> <p>\u6392\u67e5\u8fc7\u7a0b\uff1a\u628a\u5b9e\u9645\u53d1\u7ed9\u6a21\u578b\u7684 Prompt \u6253\u51fa\u6765\u770b\uff0c\u53d1\u73b0\u91cc\u9762\u6df7\u7740\u5927\u91cf\u65e0\u5173\u7684\u5386\u53f2\u5bf9\u8bdd\u2014\u2014\u8bba\u6587\u603b\u7ed3\u3001\u6f0f\u6d1e\u62a5\u544a\u3001\u7b80\u5386\u5206\u6790\uff0c\u5168\u662f\u4e4b\u524d\u4e0d\u540c\u4f1a\u8bdd\u91cc\u95ee\u8fc7\u7684\u5185\u5bb9\u3002</p> <pre><code>Context information:\n------\uff08\u5f53\u524d PDF \u7684\u68c0\u7d22\u7247\u6bb5\uff09------\n\nConversation history:\n------\uff0810 \u8f6e\u5386\u53f2\u95ee\u7b54\uff0c\u6765\u81ea\u4e4b\u524d\u6240\u6709\u4f1a\u8bdd\uff09------\n\nQuery: \u5f53\u524d\u95ee\u9898\nAnswer:\n</code></pre> <p>\u6839\u56e0\uff1aembedchain \u628a\u6240\u6709\u4f1a\u8bdd\u7684\u95ee\u7b54\u7edf\u4e00\u5b58\u8fdb\u5168\u5c40 SQLite\uff08<code>~/.embedchain/embedchain.db</code>\uff09\uff0c\u4e14\u90fd\u6302\u5728\u540c\u4e00\u4e2a\u9ed8\u8ba4 <code>app_id</code> \u4e0b\u3002\u6bcf\u6b21\u63d0\u95ee\uff0c\u6846\u67b6\u81ea\u52a8\u628a\u6700\u8fd1 10 \u8f6e\u5386\u53f2\u62fc\u8fdb Prompt\u3002\u66f4\u7cdf\u7684\u662f\uff0c\u5386\u53f2\u91cc AI \u66fe\u7ecf\u7f16\u9020\u8fc7\u7684\u56de\u7b54\u4f1a\u88ab\u518d\u6b21\u5f53\u4f5c\"\u53c2\u8003\"\u5582\u7ed9\u6a21\u578b\u2014\u2014\u5e7b\u89c9\u5f62\u6210\u81ea\u6211\u5f3a\u5316\u7684\u6076\u6027\u5faa\u73af\u3002</p> <p>\u4f8b\u5982\uff1a\u6587\u6863\u660e\u660e\u5199\u7740\"\u676d\u5dde\u4ee5\u897f\u6e56\u3001\u9f99\u4e95\u8336\u95fb\u540d\"\uff0c\u6a21\u578b\u5374\u56de\u7b54\"\u676d\u5dde\u7684\u6587\u5316\u540d\u8457\u5305\u62ec\u300a\u897f\u6e38\u8bb0\u300b\u300a\u4e09\u56fd\u6f14\u4e49\u300b\"\u2014\u2014\u8fd9\u6bb5\u7f16\u9020\u53c8\u8fdb\u5165\u5386\u53f2\uff0c\u6c61\u67d3\u540e\u7eed\u6240\u6709\u4f1a\u8bdd\u3002</p> <p>\u89e3\u51b3\u601d\u8def\uff1a\u4e0d\u518d\u4f9d\u8d56\u9ed1\u76d2\u6846\u67b6\u7684\"\u5386\u53f2\u7ba1\u7406\"\uff0c\u800c\u662f\u81ea\u5df1\u63a7\u5236 Prompt\u2014\u2014\u53ea\u653e\u68c0\u7d22\u7247\u6bb5\u548c\u5f53\u524d\u95ee\u9898\uff0c\u4e0d\u5e26\u4efb\u4f55\u5386\u53f2\u3002</p>"},{"location":"posts/rag-ollama/#rag","title":"\u6700\u7ec8\u65b9\u6848\uff1a\u91cd\u5199\u4e00\u4e2a\u7cbe\u7b80 RAG","text":"<p>\u4e0e\u5176\u7ee7\u7eed\u7ed9 embedchain \u6253\u8865\u4e01\uff0c\u4e0d\u5982\u81ea\u5df1\u5199\u4e00\u4e2a\u5b8c\u5168\u53ef\u63a7\u7684\u7cbe\u7b80\u7248\uff0c\u56db\u4e2a\u6a21\u5757\uff1a</p> \u6a21\u5757 \u804c\u8d23 <code>config.py</code> \u6240\u6709\u53ef\u914d\u7f6e\u9879\uff08\u6a21\u578b\u3001\u8def\u5f84\u3001\u5206\u5757\u53c2\u6570\uff09 <code>loader.py</code> PDF \u89e3\u6790 + \u6587\u672c\u5206\u5757\uff08\u5e26\u91cd\u53e0\uff09 <code>store.py</code> ChromaDB \u5c01\u88c5\uff08\u5d4c\u5165\u3001\u5b58\u50a8\u3001\u68c0\u7d22\uff09 <code>qa.py</code> \u68c0\u7d22 \u2192 \u7ec4\u88c5 Prompt \u2192 \u8c03\u7528\u6a21\u578b\u751f\u6210 <p>\u5173\u952e\u8bbe\u8ba1\u51b3\u7b56\uff1a</p> <ol> <li>\u6bcf\u4efd PDF \u72ec\u7acb collection\u2014\u2014\u4e0d\u540c\u6587\u6863\u7684\u95ee\u7b54\u4e92\u4e0d\u5e72\u6270</li> <li>Prompt \u53ea\u542b\u68c0\u7d22\u7247\u6bb5 + \u5f53\u524d\u95ee\u9898\u2014\u2014\u6839\u6cbb\u5386\u53f2\u6c61\u67d3</li> <li>\u7528 <code>qwen2.5:7b</code> \u66ff\u4ee3 3B \u5c0f\u6a21\u578b\u2014\u2014\u4e2d\u6587\u56de\u7b54\u8d28\u91cf\u660e\u663e\u63d0\u5347</li> <li>\u7528 <code>bge-m3</code> \u66ff\u4ee3\u82f1\u6587\u5d4c\u5165\u6a21\u578b\u2014\u2014\u4e2d\u6587\u68c0\u7d22\u66f4\u51c6</li> </ol>"},{"location":"posts/rag-ollama/#_2","title":"\u9a8c\u8bc1\u7ed3\u679c","text":"<p>\u5728\u672c\u5730 Ollama\uff0816G \u5185\u5b58\uff09\u4e0a\uff0c\u63d0\u95ee\"\u676d\u5dde\u5730\u94c11\u53f7\u7ebf\u4ec0\u4e48\u65f6\u5019\u5f00\u901a\uff1f\"\uff0c\u6a21\u578b\u80fd\u51c6\u786e\u56de\u7b54\"2012\u5e7411\u670824\u65e5\"\u2014\u2014\u5185\u5bb9\u6765\u81ea PDF\uff0c\u4e0d\u518d\u662f\u7f16\u9020\u3002</p>"},{"location":"posts/rag-ollama/#_3","title":"\u603b\u7ed3","text":"<ul> <li>\u7528\u9ed1\u76d2\u6846\u67b6\u5feb\u901f\u51fa\u6d3b\u53ef\u4ee5\uff0c\u4f46\u51fa\u95ee\u9898\u65f6\u6392\u67e5\u6210\u672c\u9ad8\uff0c\u5c24\u5176\u662f\u9690\u5f0f\u7684\"\u5386\u53f2\u7ba1\u7406\"</li> <li>RAG \u5e94\u7528\u7684\u6838\u5fc3\u4e09\u8981\u7d20\uff1a\u68c0\u7d22\u51c6\u3001Prompt \u5e72\u51c0\u3001\u6a21\u578b\u591f\u5f3a</li> <li>\u9047\u5230\"\u7b54\u975e\u6240\u95ee + \u7f16\u9020\u5185\u5bb9\"\uff0c\u4f18\u5148\u68c0\u67e5\u4e09\u4ef6\u4e8b\uff1a\u68c0\u7d22\u5230\u5185\u5bb9\u4e86\u5417\uff1fPrompt \u91cc\u6df7\u5165\u4e86\u4ec0\u4e48\uff1f\u6a21\u578b\u662f\u4e0d\u662f\u592a\u5f31\uff1f</li> </ul> <p>\u4e0b\u4e00\u7bc7\u9884\u544a\uff1a\u81ea\u5df1\u5b9e\u73b0 ChromaDB \u5411\u91cf\u5e93\u7684\u589e\u5220\u67e5\uff0c\u9644\u5b8c\u6574\u4ee3\u7801\u3002</p>"}]}